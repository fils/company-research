    "primary_data_types": [
      "Satellite data (SWOT, altimetry, SAR, optical imagery)",
      "In-situ oceanographic measurements (temperature, salinity, currents)",
      "Maritime traffic data (AIS)",
      "Bathymetric data",
      "Metocean and weather forecast data"
    ],
    "key_measurements": [
      "Sea surface height and ocean topography (SWOT satellite)",
      "Sea surface temperature (SST)",
      "Ocean currents (velocity, direction)",
      "Wind speed and direction (over ocean surface)",
      "Wave height, period, direction",
      "Salinity, water density profiles"
    ],
    "observation_programs": [
      "Real-time satellite data ingestion (SWOT, altimetry constellation, SAR)",
      "In-situ buoy network integration",
      "AI-powered data fusion engine combining multi-source data",
      "Ocean Bulletin route planning tool",
      "Maritime situational awareness for naval defence"
    ],
    "known_data_gaps": [
      "Sub-surface oceanographic data at depth",
      "High-resolution coastal bathymetry",
      "Real-time in-situ data from data-sparse regions",
      "Integration between public satellite data and proprietary in-situ networks"
    ],
    "interest_in_external_data_services": "Very high — core product depends on fusing diverse ocean data sources; actively seeking partnerships for in-situ sensor networks, satellite data providers, and oceanographic institutions"
